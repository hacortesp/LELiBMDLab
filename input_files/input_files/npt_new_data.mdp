; ========= NPT production (según repo) =========
; Integración y tiempo
integrator              = md
dt                      = 0.002      ; 2 fs
nsteps                  = 6000000    ; 12 ns

; Salida
nstlog                  = 1000
nstcalcenergy           = 100
nstenergy               = 1000
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 2000
compressed-x-precision  = 1000

; Esquema de cutoff / vecinos
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
rlist                   = 1.4

; Electrostatica / LJ
coulombtype             = PME
rcoulomb                = 1.4
vdwtype                 = Cut-off
rvdw                    = 1.4
DispCorr                = EnerPres

; Condiciones periódicas
pbc                     = xyz

; Termostato
tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 298

; Barostato (NPT)
Pcoupl                  = Parrinello-Rahman
Pcoupltype              = isotropic
tau-p                   = 1.0
compressibility         = 5e-5
ref-p                   = 1.0

; Velocidades (se asume que vienes de otra etapa)
gen-vel                 = no

; Restricciones
constraints             = all-bonds
constraint-algorithm    = Lincs
lincs-order             = 4
lincs-iter              = 1
