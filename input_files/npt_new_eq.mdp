; ============================================================
; MD para replicar la configuración del repositorio (NPT)
; ============================================================

; ==== Integrador y tiempo de integración ====
integrator              = md          ; como en el repo
dt                      = 0.002       ; ps
nsteps                  = 2000000     ; 2e6 * 0.002 ps = 4000 ps = 4 ns
tinit                   = 0

; ==== Salidas ====
nstxout                 = 0           ; no escribir coordenadas en .trr
nstvout                 = 0           ; no escribir velocidades en .trr
nstlog                  = 1000        ; cada 1000 pasos
nstcalcenergy           = 100         ; cada 100 pasos calcula energía
nstenergy               = 1000        ; salva energía en .edr cada 1000 pasos
nstxout-compressed      = 2000        ; coordenadas comprimidas (.xtc)
compressed-x-precision  = 1000

; ==== Vecinos y esquemas de corte ====
cutoff-scheme           = Verlet
nstlist                 = 10          ; lista de vecinos
ns_type                 = grid
rlist                   = 1.4

; ==== Electrostatica y van der Waals ====
coulombtype             = PME
rcoulomb                = 1.4
vdwtype                 = Cut-off
rvdw                    = 1.4
DispCorr                = EnerPres    ; corrección de energía/pressión por corte de vdW

; ==== Restricciones de enlaces ====
constraints             = all-bonds
constraint-algorithm    = Lincs
lincs-order             = 4
lincs-iter              = 1

; ==== Condiciones periódicas ====
pbc                     = xyz

; ==== Termostato (acoplamiento a temperatura) ====
tcoupl                  = v-rescale
tc-grps                 = System      ; un solo grupo de T como en el repo
tau-t                   = 0.1
ref-t                   = 298         ; K

; ==== Barostato (acoplamiento a presión, NPT Berendsen) ====
Pcoupl                  = Berendsen
Pcoupltype              = isotropic
tau-p                   = 1.0
compressibility         = 5e-5
ref-p                   = 1.0

; ==== Velocidades iniciales ====
gen_vel                 = yes
gen_temp                = 298
gen_seed                = -1
continuation            = no          ; arranque nuevo (consistente con gen_vel = yes)
