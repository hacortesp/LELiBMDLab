integrator              = md
dt                      = 0.002    ; 2 fs
nsteps                  = 100000    ; 6000000 12 ns

nstlog                  = 1000
nstcalcenergy           = 100
nstenergy               = 1000
nstxout                 = 0
nstvout                 = 0
nstxout-compressed      = 2000
compressed-x-precision  = 1000

cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
rlist                   = 1.4

coulombtype             = PME
rcoulomb                = 1.4
vdwtype                 = Cut-off
rvdw                    = 1.4
DispCorr                = EnerPres

pbc                     = xyz

tcoupl                  = v-rescale
tc-grps                 = System
tau-t                   = 0.1
ref-t                   = 298.0

Pcoupl                  = no
gen-vel                 = no

constraints             = all-bonds
constraint-algorithm    = Lincs
lincs-order             = 4
lincs-iter              = 1
