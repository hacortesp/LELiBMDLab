integrator              = md          
dt                      = 0.002       
nsteps                  = 1000 ;2000000     
tinit                   = 0

nstxout                 = 0           
nstvout                 = 0           
nstlog                  = 1000        
nstcalcenergy           = 100         
nstenergy               = 1000        
nstxout-compressed      = 2000        
compressed-x-precision  = 1000

cutoff-scheme           = Verlet
nstlist                 = 10          
ns_type                 = grid
rlist                   = 1.4

coulombtype             = PME
rcoulomb                = 1.4
vdwtype                 = Cut-off
rvdw                    = 1.4
DispCorr                = EnerPres    
constraints             = all-bonds
constraint-algorithm    = Lincs
lincs-order             = 4
lincs-iter              = 1

pbc                     = xyz

tcoupl                  = v-rescale
tc-grps                 = System      
tau-t                   = 0.1
ref-t                   = 298.0         

Pcoupl                  = Berendsen
Pcoupltype              = isotropic
tau-p                   = 1.0
compressibility         = 5e-5
ref-p                   = 1.0

gen_vel                 = yes
gen_temp                = 298.0
gen_seed                = -1
continuation            = no
